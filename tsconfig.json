{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*.mjs", "src/**/*.d.mts", "tests/architecture/**/*.mjs"]
}

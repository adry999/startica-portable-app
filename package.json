{
  "name": "startica",
  "version": "1.0.0",
  "private": true,
  "description": "Evidență locală Startica: server Node cu SQLite și interfață în fereastră Chrome/Edge.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node startica_server.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"tests/architecture/*.test.mjs\" \"src/**/*.test.mjs\"",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:e2e": "node tests/browser-smoke.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File tests/desktop-lifecycle.ps1",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}

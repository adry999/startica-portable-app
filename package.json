{
  "name": "startica",
  "version": "1.3.1",
  "private": true,
  "description": "Evidență locală Startica: server Node cu SQLite și interfață în fereastră Chrome/Edge.",
  "engines": {
    "node": ">=22.5.0"
  },
  "imports": {
    "#app/*": "./src/app/*",
    "#config/*": "./src/config/*",
    "#core/*": "./src/core/*",
    "#shared/*": "./src/shared/*",
    "#features/*": "./src/features/*",
    "#test-support/*": "./tests/support/*"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning startica_server.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"tests/architecture/*.test.mjs\" \"src/**/*.test.mjs\"",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:e2e": "node tests/browser-smoke.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File tests/desktop-lifecycle.ps1",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "check:full": "npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
